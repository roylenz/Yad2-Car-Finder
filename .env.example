TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_ADMIN_IDS=
TELEGRAM_WHITELIST_IDS=
MAX_CONCURRENT_SCANS=2
LOG_LEVEL=INFO

# Ad archive (database + photos). On the Pi, point this at the SSD folder (owned by uid 10001).
HOST_DATA_DIR=
# Optional: any SQLAlchemy URL (e.g. Postgres on Supabase) instead of SQLite in the data folder.
DATABASE_URL=
# Processors to run on archived ads/photos (comma-separated). Empty runs all of them:
# photo_info, plate_reader, plate_registry, claude_condition.
PROCESSORS=
# CPU cores the plate models may use (default 2; leave room for Chromium on the Pi).
# PLATE_THREADS=2
# Claude photo inspection (claude_condition) runs only when a key is set. Create a key in a
# Console workspace; Max/Ultra plans include monthly API credits for it.
ANTHROPIC_API_KEY=
CLAUDE_MONTHLY_BUDGET_USD=20
# CLAUDE_CONDITION_MODEL=claude-sonnet-5-5

# Dashboard (see docs/DEPLOYMENT.md). `dashboard` starts it; add `tunnel` for Cloudflare.
# COMPOSE_PROFILES=dashboard
# Home network without login (until Cloudflare Access is set up):
# DASHBOARD_BIND=0.0.0.0
# DASHBOARD_AUTH=off
DASHBOARD_PORT=8080
CLOUDFLARE_TUNNEL_TOKEN=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Public dashboard address; alerts link to each ad's history page.
DASHBOARD_URL=
